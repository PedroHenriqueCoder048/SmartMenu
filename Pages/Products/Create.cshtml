@page
@model SmartMenu.Pages.Products.CreateModel

        @{
        Layout = "_Layout";
        ViewData["Title"] = "Cadastrar produtos";
        }
        
        <!DOCTYPE html>
        
        <html>
        <head>
        <meta name="viewport" content="width=device-width" />
        @* <title>Create</title> *@
        </head>
        <body>
        
    <h4>Cadastro de produto</h4>
    <hr />
    <div class="row">
    <div class="col-md-4">
    <form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group mb-3">
                <span class="text-danger">*</span>
                <label asp-for="Product.Name" class="form-label"></label>
                <input asp-for="Product.Name" class="form-control" aria-required="true"/>
                <span asp-validation-for="Product.Name" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <span class="text-danger">*</span>
                <label asp-for="Product.UnitPrice" class="form-label"></label>
                <input asp-for="Product.UnitPrice" class="form-control" aria-required="true"/>
                <span asp-validation-for="Product.UnitPrice" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <span class="text-danger">*</span>
                <label asp-for="Product.TypeProduct" class="form-label"></label>
                <input asp-for="Product.TypeProduct" class="form-control" aria-required="true"/>
                <span asp-validation-for="Product.TypeProduct" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Product.Description" class="form-label"></label>
                <input asp-for="Product.Description" class="form-control" />
                <span asp-validation-for="Product.Description" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <span class="text-danger">*</span>
                <label asp-for="Product.Quantity" class="form-label">Quantidade</label>
                <input asp-for="Product.Quantity" class="form-control" aria-required="true"/>
                <span asp-validation-for="Product.Quantity" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <input type="submit" asp-page-handler="Save" value="Cadastra" class="btn btn-success" />
                <input type="submit" asp-page-handler="SaveAndContinue" value="Salvar e Criar Novo" class="btn btn-info" asp-page="."/>
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Retornar Lista</a>
</div>

</body>
</html>
