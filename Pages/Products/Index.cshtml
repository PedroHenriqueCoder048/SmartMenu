@page
@model SmartMenu.Pages.Products.IndexModel

@{
    Layout = "_Layout";
    ViewData["Title"] = "Cardápio";
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Index</title>
</head>
<body>
    <h4>Cardápio</h4>
<p>
    <a asp-page="Create">Adicionar Produto</a>
</p>
<form mathod="post">
<div class="row">
    @for (int i = 0 ; i < Model.Products.Count; i++)
            {
                <div class="form-group col-md-3 mb-4 mx-1 border rounded">
                    <img src="..." class="rounded mx-auto d-block" alt="...">
                    <input type="hidden" asp-for="@Model.Products[i].Id" />
                    <h3>@Model.Products[i].Name</h3>
                    <p class="fs-5">@Model.Products[i].Description</p>
                    <p class="fs-5">Apenas @Model.Products[i].UnitPrice R$</p>
                    @if (@Model.Products[i].Quantity ==  0)
                            {
                                <div class="form-group">
                                    <p class="fs-5">Produto indisponível no momento</p>
                                </div>
                            }
                            else
                            {
                                <div class="form-group">
                                    <label class="label-control mb-3"> Quantidade</label>
                                    <input class="form-control asp mb-3" type="number" min ="0" />
                                </div>
                            }
                </div>
            }
         <div class="form-group mb-3">
                <input type="submit" id="input-quantity" asp-page-handler="Save" value="Finalizar" class="btn btn-success"/>
        </div>
    </div>
</form>

</body>
</html>
